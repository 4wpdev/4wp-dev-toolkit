{
	"name": "4wpdev/4wp-dev-toolkit",
	"description": "Shared PHPCS/WPCS rules and PHPUnit bootstrap for 4wp-* plugins (dev-only, not for wordpress.org ZIP).",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
