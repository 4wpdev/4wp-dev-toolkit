# Copy to your-plugin/.github/workflows/php-quality.yml
# Plugin is checked out to plugin/ and the toolkit beside it, so both setups work:
# - new: require-dev "4wpdev/4wp-dev-toolkit" from GitHub (vendor/), <rule ref="4WP"/>
# - legacy: ../4wp-dev-toolkit path repository / phpcs.xml ref
name: PHP Quality

on:
  push:
    branches: [main, master]
  pull_request:

jobs:
  quality:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        php: ['8.3', '8.4'] # set to the plugin's supported range
    defaults:
      run:
        working-directory: plugin
    steps:
      - uses: actions/checkout@v4
        with:
          path: plugin

      - uses: actions/checkout@v4
        with:
          repository: 4wpdev/4wp-dev-toolkit
          path: 4wp-dev-toolkit

      - uses: shivammathur/setup-php@v2
        with:
          php-version: ${{ matrix.php }}
          tools: composer:v2
          coverage: none

      - name: Composer
        run: composer install --no-interaction --no-progress

      - name: PHPCS
        run: vendor/bin/phpcs -q

      - name: PHPUnit
        run: |
          if [ -f phpunit.xml ] || [ -f phpunit.xml.dist ]; then vendor/bin/phpunit --no-coverage; else echo "No PHPUnit config"; fi
