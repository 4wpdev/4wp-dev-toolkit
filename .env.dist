# Copy to .env (git-ignored) or export in the shell. Shell variables win over .env.

# --- MCP smoke test (bin/4wp-mcp-smoke) ---
# Endpoint of MCP server 4wp (4wp-mcp-connector).
WP_MCP_URL=https://4wpdev.local/wp-json/4wp/mcp
WP_USER=admin
# Application Password (Users → Profile → Application Passwords).
WP_APP_PASSWORD=
# 1 = skip TLS verification (Local self-signed certificate). Never on real sites.
WP_MCP_INSECURE=0

# --- Family check (bin/4wp-family-check) ---
# Directory with 4wp-* plugin repos. Default: parent directory of the toolkit.
FORWP_PLUGINS_DIR=
# Space-separated plugin names; empty = every 4wp-* with composer.json.
FORWP_PLUGINS=
# 1 = run "composer install" in plugins without vendor/.
FORWP_FAMILY_INSTALL=0

# --- WordPress integration tests (bin/4wp-install-wp-tests) ---
WP_VERSION=latest
WP_TESTS_DIR=
WP_CORE_DIR=
DB_NAME=wordpress_tests
DB_USER=root
DB_PASSWORD=root
# host, host:port or localhost:/path/to/mysql.sock (Local: Site → Database → Socket).
DB_HOST=localhost
